set shell := ["bash", "-euo", "pipefail", "-c"]

# Template for a govengers service (govengers/standards templates/service). Replace "example" with the service name.
# Delete what does not apply: the frontend recipes and the browser_ variables for a service without UI, openapi-check and
# the clients in generate for a service that ships no API clients.
# Tools are pinned in go.mod (TCH-002): go get -tool gotest.tools/gotestsum@v1.13.0 golang.org/x/vuln/cmd/govulncheck@v1.9.0
# github.com/sqlc-dev/sqlc/cmd/sqlc@v1.31.1 github.com/govengers/postgrestest/cmd/postgrestest@v0.1.0 github.com/oasdiff/oasdiff@v1.38.0

image := "ghcr.io/govengers/example"
version := `git describe --tags --always --dirty 2>/dev/null || echo dev`
gotestsum := "go tool gotestsum"
# One PostgreSQL for the whole run, at an address stable per checkout (TST-016, TST-019)
postgrestest := "go tool postgrestest"
coverage_threshold := "80"
coverage_excluded := "/cmd/|/internal/repository/internal/sqlc/|/internal/testdatabase/|/test/|/pkg/"
# Per-test budget (TST-017)
test_budget := "5s"
e2e_inputs := "test/e2e"
# The browser journeys (TST-020): the specs, the Go programs the journeys execute (the server and every program the
# harness runs; the record's key fingerprints them), the workers and the selected run's global timeout
browser_specs := "ui/e2e"
browser_binaries := "./cmd/server github.com/govengers/postgrestest/cmd/postgrestest"
browser_workers := "2"
browser_budget_ms := "180000"
# Paths whose change needs no journey beyond @smoke. Only Go code and embedded files, which the binaries fingerprint,
# and files no journey process reads: the record's key leaves them out (TST-020)
browser_unaffected := "cmd internal pkg test docs docker .github go.mod go.sum sqlc.yaml openapi.yaml README.md"
# Generated files, committed; generate-check fails when they differ from what generate writes (TCH-003)
generated := "internal/repository/internal/sqlc pkg/apiclient pkg/command openapi.yaml ui/src/api"

default:
    @just --list

# Regenerate the sqlc code and the API clients (pkg/apiclient, pkg/command, ui/src/api, openapi.yaml) from the livewire registry
generate:
    go tool sqlc generate
    go run ./cmd/generate

# Fail when a generated file is not what generate writes, changed or new (TCH-003, DAT-016)
generate-check: generate
    git diff --exit-code -- {{generated}}
    test -z "$(git status --porcelain -- {{generated}})"

# Vet and lint with the govengers baseline (.golangci.yml, copied from govengers/standards)
lint:
    go vet ./...
    go vet -tags e2e ./test/e2e/...
    golangci-lint run ./...

# Migrations and queries, offline: squawk, sqlc generate, build (DAT-006, DAT-016)
db-lint:
    bunx squawk-cli@2.66.0 --pg-version 18 --assume-in-transaction internal/database/migrations/*.sql
    go tool sqlc generate
    go build ./...

# Migrations, then sqlc vet against the migrated schema (DAT-016). The launcher starts a throwaway PostgreSQL for
# this recipe alone (unset POSTGRESTEST_URL: a long-lived test server must not get the schema), so the migrations
# go into its maintenance database
db-check: db-lint
    env -u POSTGRESTEST_URL {{postgrestest}} bash -c 'DATABASE_URL="$POSTGRESTEST_URL" go run ./cmd/migrate && SQLC_DATABASE_URL="$POSTGRESTEST_URL" go tool sqlc vet'

# Fail on a breaking change of the OpenAPI document since the branch left base, a git ref (default: the pull
# request's base branch in CI, otherwise origin/main); a missing ref fails, a base without the document passes
openapi-check base="":
    #!/usr/bin/env bash
    set -euo pipefail
    base="{{base}}"
    base="${base:-origin/${BASE_REF:-main}}"
    if ! git rev-parse --quiet --verify "$base^{commit}" > /dev/null; then
        echo "openapi-check: $base is not a commit" >&2
        exit 1
    fi
    # the merge base: what main gained after the branch left it is not a change of the branch
    fork="$(git merge-base "$base" HEAD)"
    if ! git cat-file -e "$fork:openapi.yaml" 2>/dev/null; then
        echo "openapi-check: $base had no openapi.yaml when the branch left it"
        exit 0
    fi
    mkdir -p sandbox
    git show "$fork:openapi.yaml" > sandbox/openapi-base.yaml
    go tool oasdiff breaking sandbox/openapi-base.yaml openapi.yaml --fail-on ERR

# Unit tests of changed and affected packages on one PostgreSQL; the Go test cache replays the rest (TST-014, TST-016).
# Fails below the coverage threshold (TST-010) and when a test took longer than the budget (TST-017)
test *flags:
    mkdir -p sandbox
    {{postgrestest}} {{gotestsum}} --format testname --jsonfile sandbox/unit.json -- -race -coverprofile=sandbox/unit.raw.cover {{flags}} ./...
    grep -v -E '{{coverage_excluded}}' sandbox/unit.raw.cover > sandbox/unit.cover
    go tool cover -func=sandbox/unit.cover > sandbox/unit.func
    awk -v threshold={{coverage_threshold}} '/^total:/ { found = 1; sub("%", "", $3); print "coverage " $3 "%"; if ($3 + 0 < threshold) { print "coverage is below " threshold "%"; exit 1 } } END { if (!found) { print "no coverage total"; exit 1 } }' sandbox/unit.func
    "{{just_executable()}}" test-budget sandbox/unit.json

# Fail when a test in the go test JSON took longer than the budget, also tests replayed from the cache (TST-017).
# On a failure it drops the test cache: a replayed result keeps its slow duration, so the next run measures again
test-budget report:
    #!/usr/bin/env bash
    set -euo pipefail
    slow="$({{gotestsum}} tool slowest --jsonfile {{report}} --threshold {{test_budget}})"
    if [ -n "$slow" ]; then
        printf 'tests over the %s budget (TST-017):\n%s\n' "{{test_budget}}" "$slow"
        go clean -testcache
        exit 1
    fi

# Every unit test, uncached and shuffled: the nightly run and before a release (TST-014, TST-005)
test-all: (test "-count=1" "-shuffle=on")

# Reproducible, coverage-instrumented server and compiled suite: their hash says whether the suite has anything new to test (TST-015)
e2e-build:
    mkdir -p sandbox/e2e-build
    go build -cover -trimpath -buildvcs=false -ldflags "-X main.version=e2e" -o sandbox/e2e-build/server ./cmd/server
    go test -c -tags e2e -trimpath -buildvcs=false -o sandbox/e2e-build/ ./test/e2e/...

# The end-to-end suite against the built server, always and shuffled (TST-011, TST-005); the nightly run calls it
test-e2e-all *flags: e2e-build
    rm -rf sandbox/coverage && mkdir -p sandbox/coverage
    E2E_BINARY={{justfile_directory()}}/sandbox/e2e-build/server GOCOVERDIR={{justfile_directory()}}/sandbox/coverage {{postgrestest}} {{gotestsum}} --format testname --jsonfile sandbox/e2e.json -- -tags e2e -trimpath -buildvcs=false -count=1 -shuffle=on {{flags}} ./test/e2e/...
    go tool covdata percent -i=sandbox/coverage
    "{{just_executable()}}" test-budget sandbox/e2e.json

# The end-to-end suite, skipped when server, suite and inputs equal a green run (TST-015); keeps sandbox/e2e.json for CI badges
test-e2e: e2e-build
    #!/usr/bin/env bash
    set -euo pipefail
    key=$(find sandbox/e2e-build {{e2e_inputs}} -type f -print0 | sort -z | xargs -0 shasum -a 256 | shasum -a 256 | cut -c1-32)
    passed="sandbox/e2e-passed/$key"
    if [ -f "$passed/e2e.json" ]; then
        echo "e2e skipped: server, suite and inputs equal the green run $key"
        cp "$passed/e2e.json" sandbox/e2e.json
        exit 0
    fi
    "{{just_executable()}}" test-e2e-all
    mkdir -p "$passed"
    cp sandbox/e2e.json "$passed/e2e.json"

# FULL=true (the nightly run) always scans: the vulnerability database changes without the code changing.
# Scan for known vulnerabilities in reachable code, skipped when go.mod, go.sum and Go equal a green scan's (TCH-008)
vulncheck:
    #!/usr/bin/env bash
    set -euo pipefail
    key=$( { shasum -a 256 go.mod go.sum; go env GOVERSION; } | shasum -a 256 | cut -c1-32)
    passed="sandbox/vulncheck-passed/$key"
    if [ "${FULL:-false}" != true ] && [ -f "$passed" ]; then
        echo "vulncheck skipped: go.mod, go.sum and the Go release equal the green scan $key"
        exit 0
    fi
    go tool govulncheck ./...
    mkdir -p sandbox/vulncheck-passed && touch "$passed"

# Build the server with the version from git (DEP-005)
build:
    go build -trimpath -ldflags "-s -w -X main.version={{version}}" -o sandbox/server ./cmd/server

# Build the image like CI does (DEP-002)
docker-build:
    docker build -f docker/server.Dockerfile --build-arg VERSION={{version}} -t {{image}}:{{version}} .

# ---- frontend (ui/) ----

# Backend and frontend for development: open the frontend's dev server, which proxies the API and login routes to the Go server (DEP-001)
dev: ui-install
    #!/usr/bin/env bash
    set -euo pipefail
    trap 'kill 0' EXIT
    go run ./cmd/server &
    cd ui && bun run dev

# The frontend's dependencies, as bun.lock pins them
ui-install:
    cd ui && bun install --frozen-lockfile

# The frontend's production build, which the server embeds (DEP-001)
ui-build: ui-install
    cd ui && bun run build

# The frontend's type checks, component and page tests and build; CI's TypeScript job (bun-version in ci.yml)
test-typescript: ui-install && ui-build
    cd ui && bunx vue-tsc --noEmit
    cd ui && bun test

# Changed paths: the arguments, one each, or else git's: with BASE_SHA (CI) its diff against the checkout, without it
# the merge base with origin/${BASE_REF:-main} against the working tree plus untracked files. A spec selects itself and
# is selected by a path at or below one it claims (a `// covers: <path> ...` line, the path must exist); a path below
# browser_unaffected adds nothing; FULL=true, a base that is not a commit of a full clone, or any other path: all.
# The browser journeys a change needs (TST-020): prints `all` or the --grep pattern `@smoke|<spec>\.spec\.ts|...`
[positional-arguments]
browser-select *paths:
    #!/usr/bin/env bash
    set -euo pipefail
    set -f # claims and paths are words, never globs
    specs_directory="{{browser_specs}}"
    every() { echo "browser-select: $1: every journey" >&2; echo all; exit 0; }
    specs=$(cd "$specs_directory" && find . -type f -name '*.spec.ts' | sed 's#^\./##' | LC_ALL=C sort)
    # one line per claim: the spec, a tab, the claimed path
    claims=""
    while IFS= read -r spec; do
        [ -n "$spec" ] || continue
        for claim in $(sed -n 's#^[[:space:]]*// covers:##p' "$specs_directory/$spec"); do
            claim="${claim%/}"
            if [ ! -e "$claim" ]; then
                echo "browser-select: $specs_directory/$spec claims $claim, which does not exist" >&2
                exit 1
            fi
            claims+="$spec"$'\t'"$claim"$'\n'
        done
    done <<< "$specs"
    if [ "${FULL:-false}" = true ]; then every "FULL=true"; fi
    if [ "$#" -gt 0 ]; then
        changed=$(printf '%s\n' "$@")
    else
        shallow=$(git rev-parse --is-shallow-repository)
        [ "$shallow" = false ] || every "a shallow clone has no reliable base"
        if [ -n "${BASE_SHA:-}" ]; then
            git cat-file -e "$BASE_SHA^{commit}" 2> /dev/null || every "BASE_SHA $BASE_SHA is not a commit of this clone"
            # a direct comparison also sees a push that moved the branch back; --no-renames lists old and new path
            changed=$(git diff -z --name-only --no-renames "$BASE_SHA" | tr '\0' '\n')
        else
            base="origin/${BASE_REF:-main}"
            fork=$(git merge-base "$base" HEAD 2> /dev/null) || every "no merge base of HEAD with $base"
            changed=$( { git diff -z --name-only --no-renames "$fork"; git ls-files -z --others --exclude-standard; } | tr '\0' '\n')
        fi
    fi
    selected=""
    while IFS= read -r path; do
        path="${path#./}"
        [ -n "$path" ] || continue
        found=""
        spec="${path#"$specs_directory"/}"
        if [ "$spec" != "$path" ] && grep -qxF -- "$spec" <<< "$specs"; then found+="$spec"$'\n'; fi
        while IFS=$'\t' read -r spec claim; do
            [ -n "$claim" ] || continue
            case "$path" in "$claim" | "$claim"/*) found+="$spec"$'\n' ;; esac
        done <<< "$claims"
        if [ -n "$found" ]; then
            selected+="$found"
            continue
        fi
        for unaffected in {{browser_unaffected}}; do
            case "$path" in "$unaffected" | "$unaffected"/*) continue 2 ;; esac
        done
        every "$path is no spec, not claimed and not below browser_unaffected"
    done <<< "$changed"
    pattern=$(printf '%s' "$selected" | sed '/^$/d' | LC_ALL=C sort -u | sed 's/[][\.*^$()+?{}|]/\\&/g' | paste -s -d '|' -)
    echo "@smoke${pattern:+|$pattern}"

# Skipped when the binaries the journeys execute, every file they may read, Bun, the selection and SHARD equal a green
# run's (TST-015); FULL=true runs every journey and ignores the records; flags go to playwright test, and a run with
# flags neither reads nor writes a record. CI sets SHARD (1/2) and CI, which installs Chromium.
# The browser journeys the change needs (browser-select), in parallel, against the server with the frontend (TST-020)
[positional-arguments]
ui-e2e *flags: ui-build
    #!/usr/bin/env bash
    set -euo pipefail
    # after the frontend, which the server embeds, and reproducibly: equal code gives equal bytes (TST-015)
    rm -rf sandbox/ui-e2e && mkdir -p sandbox/ui-e2e
    go build -trimpath -buildvcs=false -ldflags "-X main.version=e2e" -o sandbox/ui-e2e/ {{browser_binaries}}
    selection=$("{{just_executable()}}" browser-select)
    pathspec=(.)
    for path in {{browser_unaffected}}; do pathspec+=(":(exclude,literal)$path"); done
    # the binaries, and every file that exists and git tracks or does not ignore outside browser_unaffected: path and content
    key=$( {
        shasum -a 256 sandbox/ui-e2e/*
        git ls-files -z --cached --others --exclude-standard -- "${pathspec[@]}" | while IFS= read -r -d '' file; do
            if [ -f "$file" ]; then printf '%s\0' "$file"; fi
        done | LC_ALL=C sort -zu | xargs -0 shasum -a 256
        bun --version
        printf 'selection %s\nshard %s\n' "$selection" "${SHARD:-}"
    } | shasum -a 256 | cut -c1-32)
    passed="sandbox/ui-e2e-passed/$key"
    if [ "$#" -eq 0 ] && [ "${FULL:-false}" != true ] && [ -f "$passed" ]; then
        echo "ui-e2e skipped: binaries, files, Bun, selection $selection and shard ${SHARD:-none} equal the green run $key"
        exit 0
    fi
    if [ -n "${CI:-}" ]; then (cd ui && bunx playwright install --with-deps --only-shell chromium); fi
    timeout={{browser_budget_ms}}
    if [ "${FULL:-false}" = true ]; then timeout=600000; fi
    playwright=(--fully-parallel --workers={{browser_workers}} --global-timeout="$timeout")
    if [ "$selection" != all ]; then playwright+=(--grep "$selection"); fi
    if [ -n "${SHARD:-}" ]; then playwright+=(--shard="$SHARD"); fi
    echo "ui-e2e: playwright test ${playwright[*]} $*"
    binaries="$PWD/sandbox/ui-e2e"
    (cd ui && E2E_SERVER="$binaries/server" "$binaries/postgrestest" bunx playwright test "${playwright[@]}" "$@")
    if [ "$#" -eq 0 ]; then mkdir -p sandbox/ui-e2e-passed && touch "$passed"; fi

# Every browser journey, never skipped: the nightly run
[positional-arguments]
ui-e2e-all *flags:
    FULL=true "{{just_executable()}}" ui-e2e "$@"

# Everything CI runs on a change, in one go
check: lint generate-check db-check openapi-check test test-e2e test-typescript ui-e2e vulncheck
