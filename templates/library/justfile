set shell := ["bash", "-euo", "pipefail", "-c"]

# Template for a govengers library (govengers/standards templates/library).
# A library pins its tools here with go run, not with tool directives in go.mod (TCH-002).

gotestsum := "go run gotest.tools/gotestsum@v1.13.0"
govulncheck := "go run golang.org/x/vuln/cmd/govulncheck@v1.9.0"
coverage_threshold := "80"
coverage_excluded := "/examples/|/test/"
# Per-test budget: a test over it is reported with a warning, never failed (TST-017)
test_budget := "5s"
e2e_inputs := "test/e2e"

default:
    @just --list

# Vet and lint with the govengers baseline (.golangci.yml, copied from govengers/standards, LIB-005 checks enabled)
lint:
    go vet ./...
    go vet -tags e2e ./test/e2e/...
    golangci-lint run ./...

# Unit tests of changed and affected packages; the Go test cache replays the rest (TST-014). Fails below the coverage
# threshold (TST-010); reports the slowest tests and those over the budget (TST-017)
test *flags:
    mkdir -p sandbox
    {{gotestsum}} --format testname --jsonfile sandbox/unit.json -- -race -coverprofile=sandbox/unit.raw.cover {{flags}} ./...
    grep -v -E '{{coverage_excluded}}' sandbox/unit.raw.cover > sandbox/unit.cover
    go tool cover -func=sandbox/unit.cover > sandbox/unit.func
    awk -v threshold={{coverage_threshold}} '/^total:/ { found = 1; sub("%", "", $3); print "coverage " $3 "%"; if ($3 + 0 < threshold) { print "coverage is below " threshold "%"; exit 1 } } END { if (!found) { print "no coverage total"; exit 1 } }' sandbox/unit.func
    "{{just_executable()}}" test-budget sandbox/unit.json

# In GitHub Actions also a table in the job summary and a warning annotation per test over the budget. A slow test
# never fails the run: the hot path cap is the one time limit (TST-018).
# Report the ten slowest tests of the go test JSON and every test over the budget, cached ones too (TST-017)
test-budget report:
    #!/usr/bin/env bash
    set -euo pipefail
    slowest="$({{gotestsum}} tool slowest --jsonfile {{report}} --threshold 1ms --num 10)"
    slow="$({{gotestsum}} tool slowest --jsonfile {{report}} --threshold {{test_budget}})"
    printf 'slowest tests in %s:\n%s\n' "{{report}}" "${slowest:-none over 1ms}"
    if [ -n "$slow" ]; then
        printf 'tests over the %s budget (TST-017), a warning, not a failure:\n%s\n' "{{test_budget}}" "$slow"
        if [ "${GITHUB_ACTIONS:-}" = true ]; then
            while read -r package test elapsed; do
                echo "::warning title=TST-017 slow test::$package $test took $elapsed, over the {{test_budget}} budget"
            done <<< "$slow"
        fi
    fi
    if [ -n "${GITHUB_STEP_SUMMARY:-}" ] && [ -n "$slowest" ]; then
        {
            printf '### Slowest tests in %s (budget %s, TST-017)\n\n| Package | Test | Time |\n|---|---|---|\n' "{{report}}" "{{test_budget}}"
            while read -r package test elapsed; do printf '| `%s` | `%s` | %s |\n' "$package" "$test" "$elapsed"; done <<< "$slowest"
        } >> "$GITHUB_STEP_SUMMARY"
    fi

# Every unit test, uncached and shuffled: the nightly run and before a release (TST-014, TST-005)
test-all: (test "-count=1" "-shuffle=on")

# Reproducible compiled suite: its hash says whether the suite has anything new to test (TST-015)
e2e-build:
    mkdir -p sandbox/e2e-build
    go test -c -race -tags e2e -trimpath -buildvcs=false -o sandbox/e2e-build/ ./test/e2e/...

# The end-to-end suite against the public API with real collaborators, always and shuffled (TST-011, TST-005)
test-e2e-all: e2e-build
    mkdir -p sandbox
    {{gotestsum}} --format testname --jsonfile sandbox/e2e.json -- -race -tags e2e -trimpath -buildvcs=false -count=1 -shuffle=on ./test/e2e/...
    "{{just_executable()}}" test-budget sandbox/e2e.json

# The end-to-end suite, skipped when suite and inputs equal a green run (TST-015); keeps sandbox/e2e.json for CI badges
test-e2e: e2e-build
    #!/usr/bin/env bash
    set -euo pipefail
    key=$(find sandbox/e2e-build {{e2e_inputs}} -type f -print0 | sort -z | xargs -0 shasum -a 256 | shasum -a 256 | cut -c1-32)
    passed="sandbox/e2e-passed/$key"
    if [ -f "$passed/e2e.json" ]; then
        echo "e2e skipped: suite and inputs equal the green run $key"
        cp "$passed/e2e.json" sandbox/e2e.json
        exit 0
    fi
    "{{just_executable()}}" test-e2e-all
    mkdir -p "$passed"
    cp sandbox/e2e.json "$passed/e2e.json"

# Scan for known vulnerabilities in reachable code (TCH-008)
vulncheck:
    {{govulncheck}} ./...

# Everything CI runs on a change
check: lint test test-e2e vulncheck
